# Copy to .env.local. Never commit .env.local.
#
# The app runs without any of these — see "Two data modes" in the README.

# Canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project. Public: safe in the browser, RLS is the protection.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role. SERVER ONLY — never prefix with NEXT_PUBLIC_, never import into
# a Client Component. Used to record affiliate clicks and to run the ingest
# pipeline, both of which need to bypass RLS.
SUPABASE_SECRET_KEY=

# Shared secret for /api/cron/run-jobs. The cron route has no signed-in user,
# so this is its entire authorisation: unset means the endpoint is closed.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Anthropic API key for content extraction. Without it the pipeline still
# fetches pages and notices changes; it just does not read facts out of them.
# There is no free tier — add credit at console.anthropic.com. At the default
# model that buys a lot: roughly 2.5 cents per tool, and only pages that have
# actually changed are ever extracted.
ANTHROPIC_API_KEY=

# Extraction model. Defaults to claude-haiku-4-5, which is the cheap end and
# adequate for reading fields off a page. Set this to claude-opus-5 if quality
# does not hold on awkward pricing tables — it costs roughly 5x more.
INGEST_MODEL=
